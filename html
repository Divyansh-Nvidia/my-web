<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Divyansh Tiwari | BBA Student & Future Entrepreneur</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="style.css">
</head>

<body>

  <header class="nav">
    <a href="#top" class="logo">DT</a>
    <nav>
      <a href="#about">About</a>
      <a href="#ideas">Ideas</a>
      <a href="#contact">Contact</a>
      <button id="themeBtn" aria-label="Switch dark or light mode">Dark mode</button>
    </nav>
  </header>

  <main id="top">
    <section class="hero">
      <h1>I study business today.<br>I am building mine tomorrow.</h1>
      <p>Hi, I am Divyansh, a BBA student. I learn how markets work, and I turn small ideas into real plans.</p>
      <a class="btn" href="#ideas">See my ideas</a>
    </section>

    <section id="about" class="section">
      <h2>About me</h2>
      <p>I am studying Business Administration. I want to improve my English, think like an entrepreneur, and solve real
        problems for real customers.</p>
    </section>

    <section id="ideas" class="section">
      <h2>My business ideas</h2>
      <div class="grid">
        <article class="card">
          <h3>Campus Snack Box</h3>
          <p>Healthy snacks delivered to students at low prices.</p>
        </article>
        <article class="card">
          <h3>Study Buddy App</h3>
          <p>Find classmates to study with, by subject and time.</p>
        </article>
        <article class="card">
          <h3>Local Artisan Shop</h3>
          <p>An online store that helps small sellers reach customers.</p>
        </article>
      </div>
    </section>

    <section id="contact" class="section">
      <h2>Contact me</h2>
      <form id="contactForm" novalidate>
        <label>Your name <input type="text" id="name" required></label>
        <label>Your email <input type="email" id="email" required></label>
        <label>Message <textarea id="message" rows="4" required></textarea></label>
        <button type="submit" class="btn">Send message</button>
        <p id="formStatus" role="status"></p>
      </form>
    </section>
  </main>

  <footer>© <span id="year"></span> Divyansh Tiwari</footer>

  <script src="script.js"></script>
</body>

</html>